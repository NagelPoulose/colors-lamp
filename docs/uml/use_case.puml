@startuml
left to right direction
skinparam packageStyle rectangle

actor "User" as User

rectangle "COLORS Web Application" {
  usecase "Log In" as UC_Login
  usecase "Manage Colors" as UC_Manage
  usecase "Search Colors" as UC_Search
  usecase "Add Color" as UC_Add
  usecase "Log Out" as UC_Logout
}

User --> UC_Login
User --> UC_Manage
User --> UC_Search
User --> UC_Add
User --> UC_Logout

UC_Manage .> UC_Search : <<include>>
UC_Manage .> UC_Add : <<include>>

@enduml
